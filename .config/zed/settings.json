{
  "outline_panel": {
    "button": false,
    "dock": "right"
  },
  "git_panel": {
    "dock": "left"
  },
  "vim_mode": true,
  "theme": "Nord Dark",
  "icon_theme": "Warm Charmed Icons",
  "cli_default_open_behavior": "existing_window",
  "ui_font_size": 18,
  "buffer_font_size": 18,
  "buffer_line_height": {
    "custom": 1.7,
  },
  "title_bar": {
    "show_project_items": false,
    "show_onboarding_banner": false,
    // "show_user_menu": false,
    // "show_branch_name": false,
  },
  "tab_bar": {
    "show_nav_history_buttons": false,
    "show_tab_bar_buttons": false,
  },
  "toolbar": {
    "quick_actions": false,
  },
  "status_bar": {
    // "cursor_position_button": false,
  },
  "project_panel": {
    "dock": "right",
    "default_width": 300,
    "hide_root": true,
    "sticky_scroll": false,
    "scrollbar": {
      "show": "never",
    },
    "indent_guides": {
      "show": "never",
    },
  },
  "file_finder": {
    "modal_max_width": "xlarge",
  },
  "scrollbar": {
    "show": "never",
  },
  "gutter": {
    "min_line_number_digits": 0,
    "folds": false,
  },
  "indent_guides": {
    "enabled": false,
  },
  "collaboration_panel": {
    "dock": "left",
    "button": false,
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
  },
  "multi_cursor_modifier": "cmd_or_ctrl",
  "cursor_blink": false,
  "selection_highlight": false,
  "seed_search_query_from_cursor": "never",
  "tab_size": 2,
  "hover_popover_enabled": false,
  // "autosave": {
  //   "after_delay": {
  //     "milliseconds": 1000,
  //   },
  // },
  "auto_update": false,
  "extend_comment_on_newline": false,
  "horizontal_scroll_margin": 1,
  "vertical_scroll_margin": 1,
  "restore_on_file_reopen": false,
  "session": {
    "restore_unsaved_buffers": false,
  },
  "centered_layout": {
    "right_padding": 0.12,
    "left_padding": 0.12,
  },
  "vim": {
    "toggle_relative_line_numbers": true,
  },
}
